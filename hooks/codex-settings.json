{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$PYTHON \"$HOME/.codex/hooks/assistant/codex-workflow-hooks.py\" prompt"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$PYTHON \"$HOME/.codex/hooks/assistant/codex-workflow-hooks.py\" subagent"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$PYTHON \"$HOME/.codex/hooks/assistant/codex-workflow-hooks.py\" subagent"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$PYTHON \"$HOME/.codex/hooks/assistant/codex-workflow-hooks.py\" stop"
          }
        ]
      }
    ]
  }
}
